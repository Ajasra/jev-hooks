# ==============================================================================
# Jev Configuration for Google Antigravity Hooks
# Supports either Direct TypeSafe AI or OpenRouter (https://openrouter.ai/~typesafe/jev-latest)
# ==============================================================================

# OPTION 1: Use OpenRouter (Unified API Key, pay-as-you-go credits)
# Get key at: https://openrouter.ai/keys
# Model page: https://openrouter.ai/~typesafe/jev-latest
OPENROUTER_API_KEY=your_openrouter_api_key_here
# TYPESAFE_ENDPOINT=https://openrouter.ai/api/v1/systemone
# JEV_MODEL=typesafe/jev-latest

# OPTION 2: Use Direct TypeSafe AI API
# Get key at: https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

# ==============================================================================
# Optional Hook Tuning Parameters
# ==============================================================================
JEV_HOOK_TIMEOUT_SECONDS=0.8
JEV_KEEP_THRESHOLD=0.50
JEV_PRESERVE_RECENT_MESSAGES=6
