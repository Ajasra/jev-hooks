{
  "jev-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c python %USERPROFILE%\\.gemini\\config\\hooks\\jev_safety_gate.py"
          }
        ]
      }
    ]
  },
  "jev-skill-router": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "cmd /c python %USERPROFILE%\\.gemini\\config\\hooks\\jev_skill_router.py"
      }
    ]
  },
  "jev-speculative-router": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "cmd /c python %USERPROFILE%\\.gemini\\config\\hooks\\jev_speculative_router.py"
      }
    ]
  }
}
